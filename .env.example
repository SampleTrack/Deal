# ─── Copy this file to .env and fill in your real values ───────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Your Telegram Channels (use @username format) ─────────────────────────────
CHANNEL_MAIN=@your_main_deals_channel
CHANNEL_ELECTRONICS=@your_electronics_channel
CHANNEL_FASHION=@your_fashion_channel
CHANNEL_SKINCARE=@your_skincare_channel
CHANNEL_HOME=@your_home_channel

# ── Amazon Affiliate ──────────────────────────────────────────────────────────
# Get from https://affiliate-program.amazon.in
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_AFFILIATE_TAG=yourtag-21

# ── Flipkart Affiliate ────────────────────────────────────────────────────────
# Get from https://affiliate.flipkart.com
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id
FLIPKART_AFFILIATE_TOKEN=your_flipkart_affiliate_token

# ── Nykaa Affiliate ───────────────────────────────────────────────────────────
# Get from https://www.nykaa.com/affiliate
NYKAA_AFFILIATE_ID=your_nykaa_affiliate_id

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Free MongoDB Atlas: https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGO_DB_NAME=dealbot
